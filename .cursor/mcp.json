{
  "mcpServers": {
    "dart": {
      "command": "${userHome}/Develop/flutter/bin/dart",
      "args": [
        "mcp-server",
        "--flutter-sdk",
        "${userHome}/Develop/flutter"
      ]
    },
    "postgres-backend": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://fixo:fixo_dev@localhost:5432/fixo"
      ]
    },
    "puppeteer-react": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
