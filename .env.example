# ─────────────────────────────────────────────
# Fixo — Environment Variables (local dev)
# Copy to .env and adjust as needed.
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=fixo
POSTGRES_PASSWORD=fixo_dev
POSTGRES_DB=fixo
DB_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible blob storage)
MINIO_ROOT_USER=fixo
MINIO_ROOT_PASSWORD=fixo_dev_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# .NET API
API_PORT=5000

# React Admin (web)
WEB_PORT=3000

# Firebase (add your own keys)
# FIREBASE_PROJECT_ID=fixo-dev-75df4
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/app/firebase-service-account.json

# Google OAuth Web Client ID (Cloud Console > Credentials > "fixo-api-dev" Web client)
# Used by: backend Audience check + React admin Google Sign-In button.
# GOOGLE_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com

# React Admin — Vite env (must be prefixed VITE_ to be accessible in browser)
# VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com
