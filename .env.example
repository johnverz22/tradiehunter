# ─────────────────────────────────────────────
# Fixo — Environment Variables (local dev)
# Copy to .env and adjust as needed.
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=fixo
POSTGRES_PASSWORD=fixo_dev
POSTGRES_DB=fixo
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Azurite (Azure Blob Storage emulator)
AZURITE_BLOB_PORT=10000

# .NET API
API_PORT=5000
ADDRESS_RESOLUTION_PROVIDER=Linz
LINZ_API_KEY=
LINZ_ADDRESS_LAYER_ID=123113

# React Admin (web)
WEB_PORT=3000

# Firebase (add your own keys)
# FIREBASE_PROJECT_ID=fixo-dev-75df4
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/app/firebase-service-account.json

# Google OAuth Web Client ID (Cloud Console > Credentials > "fixo-api-dev" Web client)
# Used by: backend Audience check (api container: Authentication__Google__ClientId)
# + React admin Google Sign-In button. Must equal GOOGLE_CLIENT_ID in mobile/.env.json.
# If unset, POST /api/auth/google returns 503 and mobile shows "Google sign-in is not available".
# GOOGLE_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com

# React Admin — Vite env (must be prefixed VITE_ to be accessible in browser)
# VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com
LINZ_API_KEY=

# ── Email sending (EMAIL-TEMPLATE-REVISION-PLAN §5) ──────────────────────────
# Dev default: MailHog on localhost:1025, sandbox-stamped subjects.
# Production: real relay credentials + TLS + SandboxMode=false.
EmailSender__Username=
EmailSender__Password=
EmailSender__TlsMode=StartTls
EmailSender__SandboxMode=false
EmailSender__UseTemplates=true
# Web host for email CTA deep links; empty = CTAs omitted (plan §9 Q1).
Brand__FrontendBaseUrl=
