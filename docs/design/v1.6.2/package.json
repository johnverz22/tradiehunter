{
  "name": "tradiehunter-design-toolchain",
  "version": "1.6.1",
  "private": true,
  "description": "Agent toolchain for the TradieHunter/Fixo design system: HTML->Flutter AST transpiler, design audit runner, scaffolding scripts.",
  "scripts": {
    "setup": "bash agent/setup.sh",
    "audit": "bash agent/skills/ui-audit/scripts/audit.sh docs/design/v1.6.2",
    "transpile": "node tools/design2flutter/src/index.js --design docs/design/v1.6.2 --out tools/design2flutter/output",
    "transpile:frames": "node tools/design2flutter/src/index.js --design docs/design/v1.6.2 --out tools/design2flutter/output --frames",
    "check": "node tools/design2flutter/src/index.js --check tools/design2flutter/output",
    "smoke": "node tools/design2flutter/test/smoke.js",
    "new-screen": "bash agent/skills/new-screen-from-mockup/scripts/new-screen.sh",
    "refactor-check": "bash agent/skills/widget-refactor/scripts/refactor-check.sh",
    "verify": "npm run audit && npm run transpile && npm run check && npm run smoke"
  },
  "dependencies": {
    "parse5": "^8.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
