{
  "version": "1.0.0",
  "extends": "../../mobile/tokens/tokens.json",
  "_doc": "Web layer. Colour, font families, space, radii and motion are INHERITED from the mobile master. A value written as \"=path\" reads that path from the mobile tokens; \"@name\" aliases another colour in the same theme. Only web-specific roles are defined here.",
  "font": { "display": "=font.display", "body": "=font.body", "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" },
  "rename": { "text": "ink", "textSoft": "ink-soft", "textBrand": "ink-brand", "tintBrand": "brand-tint", "accentText": "accent-ink", "avTradie": "avatar", "onAvTradie": "on-avatar" },
  "color": {
    "light": {
      "lineStrong": "#7C89A3", "focus": "@brand", "onDanger": "#FFFFFF", "successInk": "#126B33",
      "sidebar": "@heroStart", "onSidebar": "@onHero", "onSidebarSoft": "#FFFFFFE6", "sidebarHover": "#FFFFFF1F", "sidebarActive": "#FFFFFF2E",
      "scrim": "#0A101E8C"
    },
    "dark": {
      "lineStrong": "#62729C", "focus": "@brand", "onDanger": "#1A0505", "successInk": "@success",
      "sidebar": "@heroStart", "onSidebar": "@onHero", "onSidebarSoft": "#FFFFFFE6", "sidebarHover": "#FFFFFF1A", "sidebarActive": "#FFFFFF29",
      "scrim": "#05080FB3"
    }
  },
  "space": { "s10": 64, "s11": 80 },
  "radii": { "sm": "=radii.small", "control": "=radii.small", "card": "=radii.control", "panel": "=radii.card", "hero": "=radii.hero", "pill": "=radii.pill" },
  "size": {
    "controlSm": 32, "control": 40, "controlLg": 48, "touch": "=size.buttonSm",
    "icon": "=size.icon", "iconSm": "=size.iconSm", "iconLg": "=size.iconLg",
    "avatarSm": 32, "avatar": 40, "avatarLg": 56,
    "topbar": 56, "sidebar": 240, "rail": 64, "drawer": 320, "contentMax": 1280, "gutter": 24, "gutterSm": 16,
    "tableHead": 44, "tableRow": 56, "tableRowCompact": 44,
    "modalSm": 400, "modalMd": 560, "modalLg": 720, "toast": 360, "focusRing": 2, "stepDot": 16
  },
  "breakpoint": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },
  "type": {
    "display": { "font": "display", "size": 32, "weight": 600, "height": 1.2, "tracking": -0.4 },
    "h1":      { "font": "display", "size": 24, "weight": 600, "height": 1.2, "tracking": -0.2 },
    "h2":      { "font": "display", "size": 20, "weight": 600, "height": 1.25, "tracking": 0 },
    "title":   { "font": "display", "size": 16, "weight": 600, "height": 1.3, "tracking": 0 },
    "button":  { "font": "display", "size": 14, "weight": 600, "height": 1.2, "tracking": 0 },
    "label":   { "font": "display", "size": 12, "weight": 600, "height": 1.3, "tracking": 0.2 },
    "stat":    { "font": "display", "size": 28, "weight": 600, "height": 1.15, "tracking": -0.3 },
    "body":    { "font": "body", "size": 15, "weight": 400, "height": 1.5, "tracking": 0 },
    "bodySm":  { "font": "body", "size": 14, "weight": 400, "height": 1.45, "tracking": 0 },
    "meta":    { "font": "body", "size": 13, "weight": 400, "height": 1.4, "tracking": 0 },
    "money":   { "font": "body", "size": 14, "weight": 600, "height": 1.45, "tracking": 0 },
    "mono":    { "font": "mono", "size": 13, "weight": 400, "height": 1.4, "tracking": 0 }
  },
  "shadow": {
    "light": {
      "card": "0 1px 2px rgba(15,23,42,.05), 0 8px 24px rgba(30,58,138,.06)",
      "pop": "0 4px 12px rgba(15,23,42,.08), 0 16px 40px rgba(30,58,138,.12)",
      "modal": "0 24px 64px rgba(10,20,60,.28)"
    },
    "dark": { "card": "none", "pop": "0 8px 32px rgba(0,0,0,.5)", "modal": "0 24px 64px rgba(0,0,0,.6)" }
  },
  "motion": { "fast": "=motion.fast", "base": "=motion.base", "slow": "=motion.slow" },
  "easing": { "standard": "cubic-bezier(.32,.72,0,1)", "out": "cubic-bezier(.2,0,0,1)" }
}
