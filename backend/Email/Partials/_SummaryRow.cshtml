@model FixoApi.Email.SummaryRowModel
@* One summary row (§3.2 "Amounts / references"): label left in Plex Sans,
    value right in Plex Mono 16px/600 — amounts and references never wrap. *@
<tr>
    <td style="padding:8px 0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:14px; color:#5B6570; text-align:left; vertical-align:top;">@Model.Row.Label</td>
    <td align="right" style="padding:8px 0; font-family:'IBM Plex Mono','Courier New',monospace; font-size:16px; font-weight:@(Model.Row.Emphasize ? "700" : "600"); color:#1D2226; text-align:right; vertical-align:top; white-space:nowrap;">@Model.Row.Value</td>
</tr>
