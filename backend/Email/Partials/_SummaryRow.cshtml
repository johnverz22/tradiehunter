@model FixoApi.Email.SummaryRowModel
@* One summary row (§3.2 "Amounts / references"): label left in Plex Sans,
    value right in Plex Mono 16px/600 — amounts and references never wrap. *@
<tr>
    <td class="th-soft" style="padding:8px 0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:14px; color:#4B5A71; text-align:left; vertical-align:top;">@Model.Row.Label</td>
    <td align="right" style="padding:8px 0; font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:16px; font-weight:@(Model.Row.Emphasize ? "700" : "600"); color:#0F172A; text-align:right; vertical-align:top; white-space:nowrap;">@Model.Row.Value</td>
</tr>
