@model FixoApi.Email.CriticalNoticeModel
@* E5 — generic critical notice (§4.2): NotificationService passes structured
    Sections instead of pre-flattened strings; each section gets its own block. *@
<h1 class="th-h1" style="margin:0 0 6px 0; font-family:'Space Grotesk',Arial,Helvetica,sans-serif; font-size:24px; font-weight:700; line-height:1.3; color:#193957;">@Model.Heading</h1>
@if (!string.IsNullOrWhiteSpace(Model.Preheader))
{
    <p style="margin:0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:14px; color:#5B6570;">@Model.Preheader</p>
}
<div style="height:1px; background-color:#E4E0D4; margin:20px 0;"></div>
@foreach (var section in Model.Sections)
{
    <h2 style="margin:0 0 8px 0; font-family:'Space Grotesk',Arial,Helvetica,sans-serif; font-size:18px; font-weight:600; line-height:1.35; color:#193957;">@(section.Heading)</h2>
    <p style="margin:0 0 8px 0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:16px; line-height:1.5; color:#1D2226;">@(section.Body)</p>
    @if (!string.IsNullOrWhiteSpace(section.Callout))
    {
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:12px 0 16px 0;">
            <tr>
                <td bgcolor="#E1EBF4" style="background-color:#E1EBF4; border-left:3px solid #193957; padding:12px 16px;">
                    <span style="font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:14px; line-height:1.5; color:#193957;">@(section.Callout)</span>
                </td>
            </tr>
        </table>
    }
}
@{ await IncludeAsync("Email.Partials._CtaButton", new FixoApi.Email.CtaButtonModel(Model.CtaLabel ?? string.Empty, Model.CtaUrl)); }
