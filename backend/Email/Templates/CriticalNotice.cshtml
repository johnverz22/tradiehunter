@model FixoApi.Email.CriticalNoticeModel
@* E5 — generic critical notice (§4.2): NotificationService passes structured
    Sections instead of pre-flattened strings; each section gets its own block. *@
<h1 class="th-h1" style="margin:0 0 6px 0; font-family:'Lexend',Arial,Helvetica,sans-serif; font-size:24px; font-weight:600; line-height:1.3; color:#1E3A8A;">@Model.Heading</h1>
@if (!string.IsNullOrWhiteSpace(Model.Preheader))
{
    <p class="th-soft" style="margin:0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:14px; color:#4B5A71;">@Model.Preheader</p>
}
<div style="height:1px; background-color:#DCE2EF; margin:20px 0;"></div>
@foreach (var section in Model.Sections)
{
    <h2 class="th-h2" style="margin:0 0 8px 0; font-family:'Lexend',Arial,Helvetica,sans-serif; font-size:18px; font-weight:600; line-height:1.35; color:#1E3A8A;">@(section.Heading)</h2>
    <p style="margin:0 0 8px 0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:15px; line-height:1.45; color:#0F172A;">@(section.Body)</p>
    @if (!string.IsNullOrWhiteSpace(section.Callout))
    {
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:12px 0 16px 0;">
            <tr>
                <td class="th-panel" bgcolor="#EBEFF8" style="background-color:#EBEFF8; border-left:3px solid #1E3A8A; padding:12px 16px;">
                    <span style="font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:14px; line-height:1.5; color:#1E3A8A;">@(section.Callout)</span>
                </td>
            </tr>
        </table>
    }
}
@{ await IncludeAsync("Email.Partials._CtaButton", new FixoApi.Email.CtaButtonModel(Model.CtaLabel ?? string.Empty, Model.CtaUrl)); }
