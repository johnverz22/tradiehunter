@model FixoApi.Email.StaffInviteModel
@* E2 — staff invite (§4.2): activation link when FrontendBaseUrl is set,
    token fallback otherwise. Valid for 24 h (Q4 — token lifespan configured). *@
<h1 class="th-h1" style="margin:0 0 6px 0; font-family:'Lexend',Arial,Helvetica,sans-serif; font-size:24px; font-weight:600; line-height:1.3; color:#1E3A8A;">@Model.TextHeading</h1>
<p class="th-soft" style="margin:0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:14px; color:#4B5A71;">An invitation to the @Model.Brand.AppName admin panel.</p>
<div style="height:1px; background-color:#DCE2EF; margin:20px 0;"></div>
@foreach (var line in Model.TextBodyLines)
{
    <p style="margin:0 0 14px 0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:15px; line-height:1.45; color:#0F172A;">@line</p>
}
@if (string.IsNullOrWhiteSpace(Model.ActivationUrl))
{
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0;">
        <tr>
            <td class="th-panel" bgcolor="#EBEFF8" style="background-color:#EBEFF8; padding:16px 20px; text-align:left;">
                <span style="display:block; font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:16px; font-weight:600; color:#1E3A8A; word-break:break-all;">@Model.Token</span>
            </td>
        </tr>
    </table>
}
@{ await IncludeAsync("Email.Partials._CtaButton", new FixoApi.Email.CtaButtonModel(Model.TextCtaLabel ?? string.Empty, Model.TextCtaUrl)); }
