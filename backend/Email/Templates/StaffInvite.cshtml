@model FixoApi.Email.StaffInviteModel
@* E2 — staff invite (§4.2): activation link when FrontendBaseUrl is set,
    token fallback otherwise. Valid for 24 h (Q4 — token lifespan configured). *@
<h1 class="th-h1" style="margin:0 0 6px 0; font-family:'Space Grotesk',Arial,Helvetica,sans-serif; font-size:24px; font-weight:700; line-height:1.3; color:#193957;">@Model.TextHeading</h1>
<p style="margin:0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:14px; color:#5B6570;">An invitation to the @Model.Brand.AppName admin panel.</p>
<div style="height:1px; background-color:#E4E0D4; margin:20px 0;"></div>
@foreach (var line in Model.TextBodyLines)
{
    <p style="margin:0 0 14px 0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:16px; line-height:1.5; color:#1D2226;">@line</p>
}
@if (string.IsNullOrWhiteSpace(Model.ActivationUrl))
{
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0;">
        <tr>
            <td bgcolor="#E1EBF4" style="background-color:#E1EBF4; padding:16px 20px; text-align:left;">
                <span style="display:block; font-family:'IBM Plex Mono','Courier New',monospace; font-size:16px; font-weight:600; color:#193957; word-break:break-all;">@Model.Token</span>
            </td>
        </tr>
    </table>
}
@{ await IncludeAsync("Email.Partials._CtaButton", new FixoApi.Email.CtaButtonModel(Model.TextCtaLabel ?? string.Empty, Model.TextCtaUrl)); }
