@model FixoApi.Email.StaffAlertModel
@* E9 — staff alert: eyebrow + heading + what happened, a summary table of the
    entity (job, amount, waiting time…) and an "Open in admin" CTA when a web host
    exists. One template for every staff event — no per-event layouts. *@
<p class="th-soft" style="margin:0 0 8px 0; font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:12px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#4B5A71;">Staff alert</p>
<h1 class="th-h1" style="margin:0 0 6px 0; font-family:'Lexend',Arial,Helvetica,sans-serif; font-size:24px; font-weight:600; line-height:1.3; color:#1E3A8A;">@Model.TextHeading</h1>
<p class="th-soft" style="margin:0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:14px; color:#4B5A71;">@Model.TextPreheader</p>
<div style="height:1px; background-color:#DCE2EF; margin:20px 0;"></div>
@foreach (var line in Model.TextBodyLines)
{
    <p style="margin:0 0 14px 0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:15px; line-height:1.45; color:#0F172A;">@line</p>
}
@if (Model.TextSummaryRows.Count > 0)
{
    <table class="th-panel" role="presentation" width="100%" bgcolor="#EBEFF8" cellpadding="0" cellspacing="0" border="0" style="background-color:#EBEFF8; border-radius:16px; margin:16px 0;">
        @foreach (var row in Model.TextSummaryRows)
        {
            <tr><td style="padding:4px 20px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">@{ await IncludeAsync("Email.Partials._SummaryRow", new FixoApi.Email.SummaryRowModel(row, Model.Brand)); }</table></td></tr>
        }
    </table>
}
@{ await IncludeAsync("Email.Partials._CtaButton", new FixoApi.Email.CtaButtonModel(Model.TextCtaLabel ?? string.Empty, Model.TextCtaUrl)); }
