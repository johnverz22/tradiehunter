@model FixoApi.Email.OtpModel
@* E1 — OTP (§4.2): no button, the code IS the CTA. Hero panel amber-top. *@
<h1 class="th-h1" style="margin:0 0 6px 0; font-family:'Space Grotesk',Arial,Helvetica,sans-serif; font-size:24px; font-weight:700; line-height:1.3; color:#193957;">@Model.TextHeading</h1>
<p style="margin:0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:14px; color:#5B6570;">Enter it in the app — it expires in 10 minutes.</p>
<div style="height:1px; background-color:#E4E0D4; margin:20px 0;"></div>
@{ await IncludeAsync("Email.Partials._HeroPanel", new FixoApi.Email.HeroPanelModel(Model.Otp, "Your 6-digit code")); }
@foreach (var line in Model.TextBodyLines)
{
    <p style="margin:0 0 14px 0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:16px; line-height:1.5; color:#1D2226;">@line</p>
}
