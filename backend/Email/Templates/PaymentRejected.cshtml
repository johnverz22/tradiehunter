@model FixoApi.Email.PaymentRejectedModel
@* E4 — receipt rejected (§4.2): reason + hero panel with the NEW deadline in NZT
    (NzTime formatting — not server-local time), then "Upload new receipt" CTA. *@
<h1 class="th-h1" style="margin:0 0 6px 0; font-family:'Lexend',Arial,Helvetica,sans-serif; font-size:24px; font-weight:600; line-height:1.3; color:#1E3A8A;">@Model.TextHeading</h1>
<p class="th-soft" style="margin:0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:14px; color:#4B5A71;">Action needed to keep this booking.</p>
<div style="height:1px; background-color:#DCE2EF; margin:20px 0;"></div>
@{ await IncludeAsync("Email.Partials._HeroPanel", new FixoApi.Email.HeroPanelModel(Model.DeadlineDisplay, "Upload a corrected receipt by this deadline")); }
<p style="margin:0 0 14px 0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:15px; line-height:1.45; color:#0F172A;">Our team couldn't accept the receipt you uploaded for <strong style="color:#0F172A;">"@Model.JobTitle"</strong>.</p>
<p style="margin:0 0 14px 0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:15px; line-height:1.45; color:#0F172A;"><strong style="color:#0F172A;">Reason:</strong> @Model.Reason</p>
<p style="margin:0 0 14px 0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:15px; line-height:1.45; color:#0F172A;">Please upload a corrected receipt by <strong style="color:#0F172A;">@Model.DeadlineDisplay</strong> so we can confirm your tradie.</p>
@{ await IncludeAsync("Email.Partials._CtaButton", new FixoApi.Email.CtaButtonModel(Model.TextCtaLabel ?? string.Empty, Model.TextCtaUrl)); }
