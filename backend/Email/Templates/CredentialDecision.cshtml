@model FixoApi.Email.CredentialDecisionModel
@* E10 — credential approved or rejected (N4.1). *@
<h1 class="th-h1" style="margin:0 0 6px 0; font-family:'Space Grotesk',Arial,Helvetica,sans-serif; font-size:24px; font-weight:700; line-height:1.3; color:#193957;">@Model.TextHeading</h1>
<p style="margin:0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:14px; color:#5B6570;">@(Model.Approved ? "Your account verification has been updated." : "Action needed on your credential.")</p>
<div style="height:1px; background-color:#E4E0D4; margin:20px 0;"></div>
@if (Model.Approved)
{
<p style="margin:0 0 14px 0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:16px; line-height:1.5; color:#1D2226;">Great news — our team reviewed and approved your <strong style="color:#1D2226;">@Model.CredentialType</strong> credential.</p>
}
else
{
<p style="margin:0 0 14px 0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:16px; line-height:1.5; color:#1D2226;">Our team couldn't approve your <strong style="color:#1D2226;">@Model.CredentialType</strong> credential.</p>
@if (!string.IsNullOrWhiteSpace(Model.RejectReason))
{
<p style="margin:0 0 14px 0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:16px; line-height:1.5; color:#1D2226;"><strong style="color:#1D2226;">Reason:</strong> @Model.RejectReason</p>
}
<p style="margin:0 0 14px 0; font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif; font-size:16px; line-height:1.5; color:#1D2226;">Please upload an updated document so we can complete your verification.</p>
}
@{ await IncludeAsync("Email.Partials._CtaButton", new FixoApi.Email.CtaButtonModel(Model.TextCtaLabel ?? string.Empty, Model.TextCtaUrl)); }
