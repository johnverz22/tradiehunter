@model FixoApi.Email.CredentialDecisionModel
@* E10 — credential approved or rejected (N4.1). *@
<h1 class="th-h1" style="margin:0 0 6px 0; font-family:'Lexend',Arial,Helvetica,sans-serif; font-size:24px; font-weight:600; line-height:1.3; color:#1E3A8A;">@Model.TextHeading</h1>
<p class="th-soft" style="margin:0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:14px; color:#4B5A71;">@(Model.Approved ? "Your account verification has been updated." : "Action needed on your credential.")</p>
<div style="height:1px; background-color:#DCE2EF; margin:20px 0;"></div>
@if (Model.Approved)
{
<p style="margin:0 0 14px 0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:15px; line-height:1.45; color:#0F172A;">Great news — our team reviewed and approved your <strong style="color:#0F172A;">@Model.CredentialType</strong> credential.</p>
}
else
{
<p style="margin:0 0 14px 0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:15px; line-height:1.45; color:#0F172A;">Our team couldn't approve your <strong style="color:#0F172A;">@Model.CredentialType</strong> credential.</p>
@if (!string.IsNullOrWhiteSpace(Model.RejectReason))
{
<p style="margin:0 0 14px 0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:15px; line-height:1.45; color:#0F172A;"><strong style="color:#0F172A;">Reason:</strong> @Model.RejectReason</p>
}
<p style="margin:0 0 14px 0; font-family:'Source Sans 3',Arial,Helvetica,sans-serif; font-size:15px; line-height:1.45; color:#0F172A;">Please upload an updated document so we can complete your verification.</p>
}
@{ await IncludeAsync("Email.Partials._CtaButton", new FixoApi.Email.CtaButtonModel(Model.TextCtaLabel ?? string.Empty, Model.TextCtaUrl)); }
