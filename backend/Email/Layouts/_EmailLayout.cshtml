@model FixoApi.Email.EmailLayoutModel
@{
    var brand = Model.Brand;
    var appName = string.IsNullOrWhiteSpace(brand.AppName) ? "TradieHunter" : brand.AppName;
    var (wordLead, wordAccent) = FixoApi.Email.BrandWordmark.Split(appName);
}<!DOCTYPE html>
<html lang="en-NZ" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>@appName</title>
    <!--[if mso]>
    <noscript><xml><o:OfficeDocumentSettings><o:AllowPNG/><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
    <style>
        table, td, p, a, h1, h2, span { font-family: Arial, Helvetica, sans-serif !important; }
    </style>
    <![endif]-->
    <style>
        /* Progressive enhancement only — everything critical is inline.
           Dark-mode overrides (v2 dark tokens): Apple Mail / Gmail iOS; tested there only.
           Author !important rules beat the inline styles in dark clients. */
        @@media (prefers-color-scheme: dark) {
            .th-page { background-color: #0A101E !important; }
            .th-card { background-color: #121A2D !important; }
            .th-card td, .th-card p, .th-card h1, .th-card h2, .th-card span { color: #E8EDF8 !important; }
            .th-soft, .th-card .th-soft { color: #9DAAC4 !important; }
            .th-card a { color: #8FA8F2 !important; }
            .th-card a.th-cta { background-color: #E8A04C !important; color: #1A1005 !important; }
            .th-card .th-h1, .th-card .th-h2 { color: #8FA8F2 !important; }
            .th-panel { background-color: #1A2540 !important; }
            .th-hero { border-top-color: #E8A04C !important; }
            .th-footer td, .th-footer p, .th-footer span { color: #9DAAC4 !important; }
        }
        [data-ogsc] .th-page { background-color: #0A101E !important; }
        [data-ogsc] .th-card { background-color: #121A2D !important; }
        [data-ogsc] .th-card td, [data-ogsc] .th-card p, [data-ogsc] .th-card h1, [data-ogsc] .th-card h2, [data-ogsc] .th-card span { color: #E8EDF8 !important; }
        [data-ogsc] .th-soft { color: #9DAAC4 !important; }
        [data-ogsc] .th-card a { color: #8FA8F2 !important; }
        [data-ogsc] .th-card a.th-cta { background-color: #E8A04C !important; color: #1A1005 !important; }
        [data-ogsc] .th-card .th-h1, [data-ogsc] .th-card .th-h2 { color: #8FA8F2 !important; }
        [data-ogsc] .th-panel { background-color: #1A2540 !important; }
        [data-ogsc] .th-hero { border-top-color: #E8A04C !important; }
        [data-ogsc] .th-footer td, [data-ogsc] .th-footer p, [data-ogsc] .th-footer span { color: #9DAAC4 !important; }
        /* Mobile clamp — 56% of opens (§3.2). */
        @@media only screen and (max-width: 620px) {
            .th-card { width: 100% !important; border-radius: 0 !important; }
            .th-gutter { padding-left: 16px !important; padding-right: 16px !important; }
            .th-h1 { font-size: 21px !important; }
        }
    </style>
</head>
<body class="th-page" style="margin:0; padding:0; width:100%; background-color:#F4F6FB; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">

    @* Inbox preheader — hidden preview line under the subject (§3.4). *@
    @if (!string.IsNullOrWhiteSpace(Model.Preheader))
    {
        <div style="display:none; font-size:1px; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;">@Model.Preheader</div>
    }

    <table role="presentation" class="th-page" width="100%" bgcolor="#F4F6FB" cellpadding="0" cellspacing="0" border="0" style="background-color:#F4F6FB;">
        <tr>
            <td align="center" style="padding:24px 12px;">

                <!--[if mso]><table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
                <table role="presentation" class="th-card" width="640" bgcolor="#FFFFFF" cellpadding="0" cellspacing="0" border="0" style="width:640px; max-width:640px; background-color:#FFFFFF; border-radius:20px;">

                    @* ── HEADER BAND — v2 hero gradient, text wordmark ──────────── *@
                    <tr>
                        <td class="th-header" bgcolor="#1E3A8A" style="background-color:#1E3A8A; background:linear-gradient(140deg,#1E3A8A,#2849B5); padding:20px; border-radius:20px 20px 0 0;" align="left">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                                <td style="padding-right:12px;" valign="middle">
                                    <img src="@Model.MarkSrc" width="40" height="40" alt="" style="display:block; border:0; outline:none; text-decoration:none; width:40px; height:40px;" />
                                </td>
                                <td valign="middle"><span style="font-family:'Lexend',Arial,Helvetica,sans-serif; font-size:20px; font-weight:800; letter-spacing:-0.5px; line-height:1.2; color:#FFFFFF; white-space:nowrap;">@wordLead<span style="color:#FFD495;">@wordAccent</span></span></td>
                            </tr></table>
                        </td>
                    </tr>

                    @* ── CARD BODY (template content) ─────────────────────────────── *@
                    <tr>
                        <td class="th-gutter" style="padding:24px 20px 8px 20px;">
                            @* RawString — the body is trusted template output; a plain
                               @expression would HTML-encode the entire card body. *@
                            @(new RazorLight.Text.RawString(Model.BodyHtml))
                        </td>
                    </tr>

                    @* ── FOOTER — paper, hairline top, why + support ──────────────── *@
                    <tr>
                        <td class="th-footer" bgcolor="#F4F6FB" style="background-color:#F4F6FB; border-top:1px solid #DCE2EF; padding:16px 20px 20px 20px; border-radius:0 0 20px 20px;">
                            @{ await IncludeAsync("Email.Partials._FooterNote", new FixoApi.Email.FooterModel(Model.FooterNote, brand)); }
                        </td>
                    </tr>

                </table>
                <!--[if mso]></td></tr></table><![endif]-->

            </td>
        </tr>
    </table>
</body>
</html>
