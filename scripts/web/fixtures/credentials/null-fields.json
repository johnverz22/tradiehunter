{
  "_comment": "Tradie with a null TradeType/BusinessName and a hostile file name: nulls render as an em dash and the file name must stay escaped.",
  "route": "/credentials",
  "prefetch": [
    {
      "key": ["admin", "credentials", "pending", { "page": 1, "pageSize": 20 }],
      "url": "/admin/credentials/pending",
      "body": {
        "items": [
          {
            "id": 99,
            "type": "Certification",
            "tradieUserId": "11111111-2222-3333-4444-555555555555",
            "tradieName": "Tradie 099",
            "tradieEmail": "tradie099@example.co.nz",
            "tradeType": null,
            "businessName": null,
            "originalFileName": "<img src=x onerror=alert(1)>.pdf",
            "downloadUrl": "http://localhost:10000/devstoreaccount1/fixo-credentials/doc-099.pdf?sig=x"
          }
        ],
        "totalCount": 1,
        "page": 1,
        "pageSize": 20,
        "totalPages": 1
      }
    }
  ],
  "expect": [
    { "label": "null trade type renders as em dash", "needle": "—" },
    { "label": "file name is HTML-escaped", "needle": "&lt;img src=x onerror=alert(1)&gt;.pdf" },
    { "label": "no raw script tag", "needle": "<img src=x onerror=", "present": false },
    { "label": "empty state is not shown", "needle": "No credentials awaiting review.", "present": false },
    { "label": "single page hides page buttons", "needle": "aria-label=\"Page 2\"", "present": false },
    { "label": "row actions are present", "needle": ">Reject</button>" }
  ]
}
