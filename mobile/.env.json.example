{
  "GOOGLE_CLIENT_ID": "REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com",
  "API_BASE_URL": "http://localhost:5000"
}

// API_BASE_URL notes — the Dio provider auto-detects Android at runtime and
// rewrites localhost → 10.0.2.2, so this single value works everywhere:
//
//   iOS Simulator    → localhost:5000   (shares macOS network stack, no change needed)
//   Android Emulator → 10.0.2.2:5000   (auto-substituted at runtime by dioProvider)
//   Physical device  → set to http://<LAN-IP>:5000  (e.g. http://192.168.1.x:5000)
//
// Run: flutter run --dart-define-from-file=.env.json
