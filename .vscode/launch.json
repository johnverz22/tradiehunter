{
  "version": "0.2.0",
  "configurations": [
    // ── Flutter ──────────────────────────────────────────────────────────────
    {
      "name": "Flutter (Android)",
      "type": "dart",
      "request": "launch",
      "program": "mobile/lib/main.dart",
      "cwd": "${workspaceFolder}/mobile",
      "args": ["--dart-define-from-file=.env.json"]
    },
    {
      "name": "Flutter (iOS)",
      "type": "dart",
      "request": "launch",
      "program": "mobile/lib/main.dart",
      "cwd": "${workspaceFolder}/mobile",
      "args": ["-d", "iphone", "--dart-define-from-file=.env.ios.json"]
    },
    {
      "name": "Flutter (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "mobile/lib/main.dart",
      "cwd": "${workspaceFolder}/mobile",
      "args": ["-d", "chrome", "--dart-define-from-file=.env.ios.json"]
    }
  ],
  "compounds": [
    // ── Run Flutter + open the admin web app in one go ────────────────────────
    // (Docker services must already be up via ./dev.sh docker)
    {
      "name": "Fixo: Flutter (Android) + Web",
      "configurations": ["Flutter (Android)"]
    }
  ]
}
